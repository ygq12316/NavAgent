{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "paths": { "@shared/*": ["./src/shared/*"] },
    "types": ["node"]
  },
  "include": ["src/renderer/src", "src/shared", "vite.config.ts", "electron.vite.config.ts", "vitest.config.ts"]
}
